<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml
  允许对局域网地址（192.168.x.x / 10.x.x.x 等）发起 HTTP 明文请求
  用于 ubus 直连（路由器通常只有 HTTP，不是 HTTPS）
-->
<network-security-config>
    <!-- 局域网地址允许明文 HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- 常见家庭网关地址段 -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">192.168.31.1</domain>
        <domain includeSubdomains="false">192.168.100.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.1.1</domain>
        <domain includeSubdomains="false">openwrt.lan</domain>
        <domain includeSubdomains="false">router.lan</domain>
    </domain-config>

    <!--
      公网地址（用户自定义 IP）也允许 HTTP
      如果路由器暴露了公网 HTTP 端口，需要这里放行
      生产环境建议用户配置 HTTPS + 证书
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- 如果用户有自签名证书，可在此处添加 user 信任锚 -->
            <!-- <certificates src="user" /> -->
        </trust-anchors>
    </base-config>
</network-security-config>
