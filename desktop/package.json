{
  "name": "OpenWRT-Manager-Desktop",
  "version": "1.0.0",
  "description": "OpenWrt 路由器管理桌面客户端",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win-x64": "npm run build && electron-builder --win --x64",
    "dist:win-ia32": "npm run build && electron-builder --win --ia32"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.1",
    "zustand": "^4.4.7",
    "lucide-react": "^0.294.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.6",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.openwrt.manager",
    "productName": "OpenWrt Manager",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenWrt Manager",
      "language": "2052",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "menuCategory": "OpenWrt Manager",
      "perMachine": false,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "publish": null,
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "description": "OpenWrt 路由器管理工具",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3"
      ],
      "packageCategory": "net",
      "priority": "optional",
      "maintainer": "OpenWrt Manager <g670677773@gmail.com>"
    },
    "rpm": {
      "depends": [
        "libnotify",
        "libXtst"
      ],
      "maintainer": "OpenWrt Manager <g670677773@gmail.com>"
    }
  },
  "author": {
    "name": "OpenWrt Manager",
    "email": "g670677773@gmail.com"
  },
  "homepage": "https://github.com/StephenJose-Dai/openwrt-manager"
}
