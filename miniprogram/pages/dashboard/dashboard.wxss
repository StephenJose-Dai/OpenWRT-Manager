/* pages/dashboard/dashboard.wxss */
page { background: #0f1117; color: #e6edf3; font-family: -apple-system,"PingFang SC",sans-serif; }
.page { padding: 0 0 120rpx; }

/* Topbar */
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 28rpx; background: #161b22; border-bottom: 1rpx solid #30363d; }
.router-switcher { display: flex; align-items: center; gap: 10rpx; flex: 1; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.status-dot.online  { background: #3fb950; box-shadow: 0 0 8rpx #3fb950; }
.status-dot.offline { background: #f85149; }
.router-name    { font-size: 28rpx; font-weight: 600; flex: 1; }
.switcher-arrow { font-size: 20rpx; color: #8b949e; }
.refresh-btn    { padding: 8rpx 16rpx; }
.spin { display: inline-block; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Switcher dropdown */
.switcher-dropdown { background: #161b22; border-bottom: 1rpx solid #30363d; }
.switcher-item { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 28rpx; }
.switcher-item.active { background: #1f3a6e22; }
.switcher-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #555; flex-shrink: 0; }
.switcher-dot.active { background: #3fb950; }
.switcher-info { flex: 1; }
.switcher-label { display: block; font-size: 28rpx; font-weight: 500; }
.switcher-host  { display: block; font-size: 22rpx; color: #8b949e; margin-top: 2rpx; }
.switcher-check { color: #4f8ef7; font-size: 28rpx; }
.switcher-add   { display: block; padding: 22rpx 28rpx; font-size: 26rpx; color: #4f8ef7; border-top: 1rpx solid #30363d; }

/* Offline banner */
.offline-banner { margin: 24rpx 28rpx; background: #2a1010; border: 1rpx solid #7f1d1d55; border-radius: 12rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; }
.offline-banner text { font-size: 26rpx; color: #f85149; }
.btn-retry { background: #f85149; color: white; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx; }

/* Cards */
.info-card, .mem-card, .iface-card {
  margin: 24rpx 28rpx 0;
  background: #161b22; border: 1rpx solid #30363d;
  border-radius: 16rpx; padding: 20rpx 24rpx;
}
.card-title { font-size: 24rpx; color: #8b949e; font-weight: 500; display: block; margin-bottom: 16rpx; }

/* Info rows */
.info-row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #21262d; }
.info-row:last-child { border-bottom: none; }
.info-label { width: 140rpx; font-size: 26rpx; color: #8b949e; flex-shrink: 0; }
.info-val   { font-size: 26rpx; color: #e6edf3; flex: 1; }

/* Memory */
.mem-header { display: flex; justify-content: space-between; margin-bottom: 14rpx; }
.mem-pct    { font-size: 26rpx; font-weight: 600; color: #e6edf3; }
.progress-bar  { height: 10rpx; background: #21262d; border-radius: 10rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 10rpx; transition: width .3s; }
.progress-fill.ok     { background: #3fb950; }
.progress-fill.warn   { background: #d29922; }
.progress-fill.danger { background: #f85149; }

/* Interfaces */
.iface-list { display: flex; flex-direction: column; gap: 12rpx; }
.iface-item { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #21262d; }
.iface-item:last-child { border-bottom: none; }
.iface-item.down { opacity: .4; }
.iface-left  { display: flex; align-items: center; gap: 10rpx; }
.iface-dot   { width: 10rpx; height: 10rpx; border-radius: 50%; flex-shrink: 0; }
.iface-dot.up { background: #3fb950; }
.iface-dot.down { background: #555; }
.iface-name  { font-size: 26rpx; font-weight: 500; }
.iface-ip    { font-size: 22rpx; color: #8b949e; margin-left: 8rpx; }
.iface-right { display: flex; gap: 16rpx; }
.iface-stat  { font-size: 22rpx; color: #8b949e; }

/* Action grid */
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 24rpx 28rpx 0; }
.action-btn {
  background: #161b22; border: 1rpx solid #30363d;
  border-radius: 16rpx; padding: 28rpx 20rpx;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  font-size: 26rpx; color: #e6edf3;
}
.action-btn.danger { border-color: #7f1d1d55; color: #f85149; background: #2a101022; }
.action-icon { font-size: 44rpx; }
