/* pages/traffic/traffic.wxss */
page { background: #0f1117; color: #e6edf3; font-family: -apple-system,"PingFang SC",sans-serif; }
.page { padding: 20rpx 28rpx 120rpx; }

/* Iface tabs */
.iface-tabs { display: flex; white-space: nowrap; margin-bottom: 20rpx; }
.iface-tab {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx; margin-right: 12rpx;
  background: #161b22; border: 1rpx solid #30363d;
  border-radius: 40rpx; font-size: 24rpx; color: #8b949e;
  flex-shrink: 0;
}
.iface-tab.active { border-color: #4f8ef7; color: #4f8ef7; background: #1f4a8f22; }
.iface-tab.down   { opacity: .4; }
.tab-dot { width: 8rpx; height: 8rpx; border-radius: 50%; flex-shrink: 0; }
.tab-dot.up   { background: #3fb950; }
.tab-dot.down { background: #555; }

/* Speed card */
.speed-card {
  display: flex; align-items: stretch;
  background: #161b22; border: 1rpx solid #30363d;
  border-radius: 16rpx; margin-bottom: 20rpx;
  overflow: hidden;
}
.speed-item { flex: 1; padding: 32rpx 20rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.speed-divider { width: 1rpx; background: #30363d; flex-shrink: 0; }
.speed-label { font-size: 24rpx; color: #8b949e; }
.speed-val { font-size: 38rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.speed-val.rx { color: #60a5fa; }
.speed-val.tx { color: #34d399; }

/* Chart */
.chart-card { background: #161b22; border: 1rpx solid #30363d; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; }
.chart-title { font-size: 22rpx; color: #8b949e; display: block; margin-bottom: 16rpx; }
.chart-canvas { width: 100%; height: 200rpx; display: block; }

/* Total */
.total-card { background: #161b22; border: 1rpx solid #30363d; border-radius: 16rpx; padding: 20rpx 24rpx; }
.total-row  { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #21262d; }
.total-row:last-child { border-bottom: none; }
.total-label{ font-size: 26rpx; color: #8b949e; }
.total-val  { font-size: 28rpx; font-weight: 600; }
.total-val.rx { color: #60a5fa; }
.total-val.tx { color: #34d399; }
