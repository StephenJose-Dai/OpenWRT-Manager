/* pages/system/system.wxss */
page { background: #0f1117; color: #e6edf3; font-family: -apple-system,"PingFang SC",sans-serif; }
.page { padding: 20rpx 28rpx 120rpx; }

/* Tabs */
.tabs { display: flex; background: #161b22; border: 1rpx solid #30363d; border-radius: 14rpx; padding: 6rpx; margin-bottom: 20rpx; }
.tab  { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: #8b949e; border-radius: 10rpx; transition: all .2s; }
.tab.active { background: #4f8ef7; color: white; font-weight: 500; }

/* Info card */
.info-card { background: #161b22; border: 1rpx solid #30363d; border-radius: 16rpx; padding: 8rpx 24rpx; margin-bottom: 20rpx; }
.info-row  { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #21262d; }
.info-row:last-child { border-bottom: none; }
.il { width: 150rpx; font-size: 26rpx; color: #8b949e; flex-shrink: 0; }
.iv { font-size: 26rpx; color: #e6edf3; flex: 1; }
.iv-col { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.mini-bar  { height: 8rpx; background: #21262d; border-radius: 4rpx; overflow: hidden; }
.mini-fill { height: 100%; border-radius: 4rpx; }
.mini-fill.ok     { background: #3fb950; }
.mini-fill.danger { background: #f85149; }

/* Action list */
.action-list { background: #161b22; border: 1rpx solid #30363d; border-radius: 16rpx; overflow: hidden; }
.action-item { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid #21262d; }
.action-item:last-child { border-bottom: none; }
.action-icon-text { font-size: 32rpx; width: 48rpx; text-align: center; }
.action-content { flex: 1; }
.action-name { display: block; font-size: 28rpx; font-weight: 500; color: #e6edf3; }
.action-desc { display: block; font-size: 22rpx; color: #8b949e; margin-top: 4rpx; }
.action-chevron { font-size: 26rpx; color: #555; }
.action-chevron.danger { color: #f85149; }

/* WiFi */
.wifi-list { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }
.wifi-item { display: flex; align-items: center; gap: 14rpx; background: #161b22; border: 1rpx solid #30363d; border-radius: 14rpx; padding: 18rpx 20rpx; }
.wifi-item.selected { border-color: #4f8ef7; background: #1f4a8f22; }
.wifi-icon { font-size: 36rpx; }
.wifi-info { flex: 1; }
.wifi-ssid    { display: block; font-size: 28rpx; font-weight: 500; }
.wifi-section { display: block; font-size: 22rpx; color: #8b949e; margin-top: 2rpx; }
.wifi-check   { font-size: 28rpx; color: #4f8ef7; font-weight: 700; }

.form-card { background: #161b22; border: 1rpx solid #30363d; border-radius: 16rpx; padding: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.field     { display: flex; flex-direction: column; gap: 6rpx; }
.flabel    { font-size: 22rpx; color: #8b949e; }
.finput    { background: #0f1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 14rpx 16rpx; font-size: 26rpx; color: #e6edf3; }
.flex1     { flex: 1; }
.pwd-row   { display: flex; gap: 12rpx; align-items: center; }
.show-btn  { font-size: 24rpx; color: #4f8ef7; white-space: nowrap; }
.fbtn-save { background: #4f8ef7; border-radius: 10rpx; padding: 18rpx; text-align: center; color: white; font-size: 28rpx; font-weight: 500; }
.fbtn-save.disabled { opacity: .6; }
.warn-text { font-size: 22rpx; color: #d29922; }

/* Log */
.log-viewer { height: 700rpx; background: #0a0e14; border-radius: 12rpx; border: 1rpx solid #30363d; padding: 16rpx; }
.log-line   { padding: 2rpx 0; }
.log-normal { font-size: 20rpx; font-family: monospace; color: #7ee787; }
.log-err    { font-size: 20rpx; font-family: monospace; color: #f85149; }
.log-warn   { font-size: 20rpx; font-family: monospace; color: #d29922; }
.log-actions { margin-top: 12rpx; text-align: center; }
.btn-refresh-log { display: inline-block; font-size: 24rpx; color: #8b949e; background: #21262d; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 12rpx 28rpx; }
.loading { padding: 60rpx; text-align: center; color: #8b949e; font-size: 26rpx; }
.empty   { padding: 80rpx 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #8b949e; }
