<!-- pages/add/add.wxml -->
<view class="page">
  <view class="form-header">
    <navigator url="/pages/index/index" open-type="navigateBack" class="back-btn">← 返回</navigator>
    <text class="form-title">{{editId ? '编辑路由器' : '添加路由器'}}</text>
  </view>

  <view class="form">

    <!-- 显示名称 -->
    <view class="field">
      <text class="label">显示名称</text>
      <input class="input" placeholder="如：家里的路由器" value="{{form.label}}" data-field="label" bindinput="setField" />
    </view>

    <!-- 协议选择 -->
    <view class="field">
      <text class="label">连接协议</text>
      <view class="proto-row">
        <view class="proto-btn {{proto === 'http' ? 'active' : ''}}" bindtap="switchProto" data-proto="http">HTTP</view>
        <view class="proto-btn {{proto === 'https' ? 'active' : ''}}" bindtap="switchProto" data-proto="https">HTTPS</view>
      </view>
    </view>

    <!-- 忽略 SSL（HTTPS 时显示）-->
    <view wx:if="{{proto === 'https'}}" class="ssl-card">
      <view class="ssl-left">
        <text class="ssl-title">忽略 SSL 证书错误</text>
        <text class="ssl-desc">自签名证书或证书过期时开启</text>
      </view>
      <view class="toggle {{ignoreSSL ? 'on' : ''}}" bindtap="toggleSSL"></view>
    </view>

    <!-- 地址 + 端口 -->
    <view class="field {{errors.host ? 'error' : ''}}">
      <text class="label">路由器地址 <text class="required">*</text></text>
      <view class="input-row">
        <input class="input flex1" placeholder="192.168.1.1 或 域名" value="{{form.host}}" data-field="host" bindinput="setField" />
        <input class="input port-input" type="number" placeholder="{{proto === 'https' ? '443' : '80'}}" value="{{form.port}}" bindinput="setPort" />
      </view>
      <text wx:if="{{errors.host}}" class="err-msg">{{errors.host}}</text>
    </view>

    <!-- 用户名 -->
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="root" value="{{form.username}}" data-field="username" bindinput="setField" />
    </view>

    <!-- 密码 -->
    <view class="field {{errors.password ? 'error' : ''}}">
      <text class="label">密码 <text class="required">*</text></text>
      <view class="pwd-row">
        <input class="input flex1" password="{{!showPwd}}" placeholder="路由器登录密码" value="{{form.password}}" data-field="password" bindinput="setField" />
        <view class="show-btn" bindtap="togglePwd">{{showPwd ? '隐藏' : '显示'}}</view>
      </view>
      <text wx:if="{{errors.password}}" class="err-msg">{{errors.password}}</text>
    </view>

    <!-- 测试连接 -->
    <view class="test-row">
      <view class="btn-test {{testing ? 'disabled' : ''}}" bindtap="testConnect">
        <text>{{testing ? '测试中...' : '测试连接'}}</text>
      </view>
      <text wx:if="{{testResult === 'ok'}}"   class="test-ok">✓ 连接成功</text>
      <text wx:if="{{testResult === 'fail'}}" class="test-fail">✗ 连接失败</text>
    </view>

    <!-- 验证码 -->
    <view class="field {{errors.captcha ? 'error' : ''}}">
      <text class="label">验证码 <text class="required">*</text></text>
      <view class="captcha-row">
        <canvas
          id="captcha-canvas"
          type="2d"
          class="captcha-canvas {{captchaWrong ? 'shake' : ''}}"
          bindtap="onCaptchaTap"
        />
        <input class="input captcha-input" placeholder="输入验证码" maxlength="4"
          value="{{captchaInput}}" data-field="captchaInput" bindinput="setField" />
      </view>
      <text wx:if="{{errors.captcha}}" class="err-msg">{{errors.captcha}}</text>
      <text class="captcha-hint">点击图片刷新验证码</text>
    </view>

    <!-- 记住密码 / 自动登录 -->
    <view class="checkbox-group">
      <checkbox-group bindchange="toggleRemember">
        <label class="checkbox-item">
          <checkbox value="1" checked="{{form.rememberPassword}}" color="#4f8ef7" />
          <text>记住密码</text>
        </label>
      </checkbox-group>
      <checkbox-group bindchange="toggleAuto">
        <label class="checkbox-item {{!form.rememberPassword ? 'disabled' : ''}}">
          <checkbox value="1" checked="{{form.autoLogin}}" disabled="{{!form.rememberPassword}}" color="#4f8ef7" />
          <text>自动登录</text>
          <text wx:if="{{!form.rememberPassword}}" class="hint-text">（需先开启记住密码）</text>
        </label>
      </checkbox-group>
    </view>

    <!-- 保存按钮 -->
    <view class="btn-save {{saving ? 'disabled' : ''}}" bindtap="onSave">
      <text>{{saving ? '连接中...' : '保存并连接'}}</text>
    </view>

  </view>
</view>
