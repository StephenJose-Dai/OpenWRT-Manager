<!-- pages/index/index.wxml -->
<view class="page">

  <!-- 标题 -->
  <view class="header">
    <view class="header-logo">
      <image src="/assets/router-icon.png" class="logo-img" />
      <view>
        <text class="title">OpenWrt Manager</text>
        <text class="subtitle">路由器管理</text>
      </view>
    </view>
  </view>

  <!-- 已保存的路由器 -->
  <view wx:if="{{routers.length > 0}}" class="section">
    <view class="section-title">已保存的路由器</view>
    <view class="router-list">
      <view
        wx:for="{{routers}}"
        wx:key="id"
        class="router-card {{activeId === item.id ? 'active' : ''}}"
        bindtap="onRouterTap"
        data-id="{{item.id}}"
      >
        <view class="router-icon">
          <image src="/assets/router-icon.png" class="card-icon" />
        </view>
        <view class="router-info">
          <text class="router-label">{{item.label || item.host}}</text>
          <text class="router-host">{{item.host}}{{item.port !== 80 ? ':' + item.port : ''}}</text>
          <view class="router-tags">
            <text class="tag tag-blue">{{item.username}}</text>
            <text wx:if="{{item.autoLogin}}" class="tag tag-green">自动登录</text>
            <text wx:if="{{item.rememberPassword}}" class="tag tag-gray">记住密码</text>
          </view>
        </view>
        <view class="router-arrow">→</view>
        <!-- 删除按钮 -->
        <view
          class="router-delete"
          catchtap="onDeleteRouter"
          data-id="{{item.id}}"
        >✕</view>
      </view>
    </view>

    <!-- 添加更多 -->
    <view class="btn-add-more" bindtap="onAddTap">
      <text>＋ 添加路由器</text>
    </view>
  </view>

  <!-- 局域网扫描 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">局域网自动发现</text>
      <view class="btn-scan {{scanning ? 'disabled' : ''}}" bindtap="startScan">
        <text>{{scanning ? '扫描中...' : '开始扫描'}}</text>
      </view>
    </view>

    <!-- 扫描动画 -->
    <view wx:if="{{scanning}}" class="scan-anim">
      <view class="scan-ring r1" />
      <view class="scan-ring r2" />
      <view class="scan-ring r3" />
      <text class="scan-text">正在探测局域网路由器...</text>
    </view>

    <!-- 发现的路由器 -->
    <view wx:if="{{foundList.length > 0}}" class="found-list">
      <view
        wx:for="{{foundList}}"
        wx:key="host"
        class="found-card"
        bindtap="onFoundTap"
        data-host="{{item.host}}"
      >
        <view class="found-dot" />
        <view class="found-info">
          <text class="found-host">{{item.host}}</text>
          <text class="found-sub">OpenWrt 路由器 · 点击连接</text>
        </view>
        <text class="found-arrow">→</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!scanning && foundList.length === 0 && routers.length === 0}}" class="empty">
      <text>点击"开始扫描"发现局域网路由器</text>
      <text>或手动添加</text>
    </view>
  </view>

  <!-- 手动添加（无路由器时显示大按钮）-->
  <view wx:if="{{routers.length === 0}}" class="btn-manual" bindtap="onAddTap">
    <text>手动添加路由器</text>
  </view>

</view>
